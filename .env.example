# Server & Auth
PORT=8787
API_BEARER_TOKEN=change-me-in-production
REQUIRE_AUTH=false

# Resource & Safety Budgets (4 GB GCP VM defaults)
MAX_BODY_BYTES=5242880
CONNECT_TIMEOUT_S=5.0
READ_TIMEOUT_S=15.0
MAX_REDIRECTS=5
MAX_ITEMS_LIMIT=200
GLOBAL_CONCURRENCY=2
PER_DOMAIN_CONCURRENCY=1
RATE_LIMIT_PER_MINUTE=60
ALLOW_PRIVATE_NETWORKS=false

# Storage & Cache
SQLITE_PATH=data/scraper.db
CACHE_TTL_SECONDS=600

# Crawl Budgets
CRAWL_MAX_PAGES_LIMIT=50
CRAWL_MAX_DEPTH_LIMIT=3
CRAWL_MIN_JITTER_S=1.5
CRAWL_MAX_JITTER_S=4.0

# Optional Tier 2 Challenge Sidecar (B00H0O/cloudflare-solver)
CF_SOLVER_ENABLED=false
CF_SOLVER_URL=http://cloudflare-solver:407
CF_CLEARANCE_TTL_SECONDS=1200

# Optional Tier 3 Browser Fallback
BROWSER_ENABLED=false
